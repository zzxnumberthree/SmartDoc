# Copy this file to .env and replace every placeholder before running Compose.
GOOGLE_API_KEY=replace-with-a-valid-gemini-api-key
DB_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_PASSWORD=replace-with-a-strong-application-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional settings
SMARTDOC_PORT=8080
AI_PROXY_ENABLED=false
AI_PROXY_HOST=
AI_PROXY_PORT=
